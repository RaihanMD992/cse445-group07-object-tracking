        "                    cls_id = int(box.cls[0])\n",
        "                    # Remap classes: 0 -> 0 (player), 32 -> 1 (ball)\n",
        "                    custom_cls = 0 if cls_id == 0 else 1\n",
        "                    x1, y1, x2, y2 = box.xyxy[0].cpu().numpy()\n",
