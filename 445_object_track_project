        "\n",
        "import os\n",
        "import cv2\n",
        "import glob\n",
        "import pandas as pd\n",
        "from ultralytics import YOLO\n",
        "from google.colab import userdata\n",
        "from huggingface_hub import HfApi, login\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 1. Setup File Paths\n",
        "# ---------------------------------------------------------\n",
        "DRIVE_DIR = \"/content/drive/MyDrive/CSE445_Videos\"\n",
        "INPUT_VIDEO_NAME = \"drone_basketball.mp4\"\n",
        "INPUT_VIDEO = os.path.join(DRIVE_DIR, INPUT_VIDEO_NAME)\n",
        "\n",
        "OUTPUT_VIDEO = os.path.join(DRIVE_DIR, \"tracked_drone_basketball_multi.mp4\")\n",
        "OUTPUT_CSV = os.path.join(DRIVE_DIR, \"drone_basketball_analytics_multi.csv\")\n",
        "HF_REPO_ID = \"RaihanGG2026/yolov8-drone-footage\"\n",
        "\n",
        "if not os.path.exists(INPUT_VIDEO):\n",
        "    available_videos = glob.glob(f\"{DRIVE_DIR}/*.mp4\")\n",
        "    if available_videos:\n",
        "        INPUT_VIDEO = available_videos[0]\n",
        "    else:\n",
        "        raise FileNotFoundError(f\"No video found in {DRIVE_DIR}\")\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 2. Load High-Capacity Pretrained Model\n",
        "# ---------------------------------------------------------\n",
        "print(\"🚀 Loading YOLOv8 Extra Large Model for High-Altitude Small Target Detection...\")\n",
        "model = YOLO(\"yolov8x.pt\")  # High capacity feature maps for small objects\n",
        "\n",
        "cap = cv2.VideoCapture(INPUT_VIDEO)\n",
        "fps = int(cap.get(cv2.CAP_PROP_FPS)) or 30\n",
        "frame_w = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))\n",
        "frame_h = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))\n",
        "total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\n",
        "\n",
        "fourcc = cv2.VideoWriter_fourcc(*\"mp4v\")\n",
        "out = cv2.VideoWriter(OUTPUT_VIDEO, fourcc, fps, (frame_w, frame_h))\n",
        "\n",
        "analytics_data = []\n",
        "unique_ids = set()\n",
        "frame_idx = 0\n",
        "\n",
        "print(f\"🎥 Processing {total_frames} frames at 1280px resolution with low-confidence ByteTrack...\")\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 3. High-Resolution Multi-Object Tracking Loop\n",
        "# ---------------------------------------------------------\n",
        "while cap.isOpened():\n",
        "    ret, frame = cap.read()\n",
        "    if not ret:\n",
        "        break\n",
        "\n",
        "    frame_idx += 1\n",
        "\n",
        "    # Track with class 0 (person/player) at 1280px resolution with conf=0.12\n",
        "    results = model.track(\n",
        "        frame,\n",
        "        persist=True,\n",
        "        tracker=\"bytetrack.yaml\",\n",
        "        imgsz=1280,      # High resolution preserves tiny high-altitude players\n",
        "        conf=0.12,       # Lower threshold catches distant/small players\n",
        "        iou=0.4,         # Lower IoU helps handle player overlaps\n",
        "        classes=[0],     # Track people/players only\n",
        "        verbose=False\n",
        "    )\n",
        "\n",
        "    annotated_frame = frame.copy()\n",
        "\n",
        "    if results[0].boxes is not None and results[0].boxes.id is not None:\n",
        "        boxes = results[0].boxes.xyxy.cpu().numpy()\n",
        "        track_ids = results[0].boxes.id.int().cpu().numpy()\n",
        "        confs = results[0].boxes.conf.cpu().numpy()\n",
        "\n",
        "        for box, track_id, conf in zip(boxes, track_ids, confs):\n",
        "            x1, y1, x2, y2 = box\n",
        "            w_box, h_box = (x2 - x1), (y2 - y1)\n",
        "\n",
        "            # Filter out unnaturally large bounding boxes (e.g., surrounding court lines or bleachers)\n",
        "            if w_box > (frame_w * 0.35) or h_box > (frame_h * 0.35):\n",
        "                continue\n",
        "\n",
        "            unique_ids.add(int(track_id))\n",
        "\n",
        "            # Draw player bounding box & ID label\n",
        "            cv2.rectangle(annotated_frame, (int(x1), int(y1)), (int(x2), int(y2)), (0, 255, 0), 2)\n",
        "            cv2.putText(annotated_frame, f\"Player #{track_id}\", (int(x1), int(y1) - 6),\n",
        "                        cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 0), 2)\n",
        "\n",
        "            analytics_data.append({\n",
        "                \"frame_number\": frame_idx,\n",
        "                \"timestamp_sec\": round(frame_idx / fps, 2),\n",
        "                \"object_id\": int(track_id),\n",
        "                \"class_name\": \"player\",\n",
        "                \"confidence\": round(float(conf), 4),\n",
        "                \"bbox_x1\": round(float(x1), 2),\n",
        "                \"bbox_y1\": round(float(y1), 2),\n",
        "                \"bbox_x2\": round(float(x2), 2),\n",
        "                \"bbox_y2\": round(float(y2), 2)\n",
        "            })\n",
        "\n",
        "    out.write(annotated_frame)\n",
        "    if frame_idx % 50 == 0 or frame_idx == total_frames:\n",
        "        print(f\"  ➜ Processed frame {frame_idx}/{total_frames} | Players Tracked So Far: {len(unique_ids)}\")\n",
        "\n",
        "cap.release()\n",
        "out.release()\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 4. Save Analytics & Sync to Hugging Face\n",
        "# ---------------------------------------------------------\n",
        "df = pd.DataFrame(analytics_data)\n",
        "df.to_csv(OUTPUT_CSV, index=False)\n",
        "\n",
        "print(\"\\n\" + \"=\"*60)\n",
