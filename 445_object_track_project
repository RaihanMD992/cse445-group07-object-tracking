        "import os\n",
        "import cv2\n",
        "import pandas as pd\n",
        "from ultralytics import YOLO\n",
        "from google.colab import userdata\n",
        "from huggingface_hub import login\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 1. Hugging Face Authentication (via Colab Secrets)\n",
        "# ---------------------------------------------------------\n",
        "try:\n",
        "    hf_token = userdata.get('445_ObjecTracker')\n",
        "    login(token=hf_token)\n",
        "    print(\"✅ Successfully logged in to Hugging Face!\")\n",
        "except Exception as e:\n",
        "    print(\"⚠️ Hugging Face Token not found in Secrets. Proceeding locally.\")\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 2. Paths & Setup\n",
        "# ---------------------------------------------------------\n",
        "DRIVE_DIR = \"/content/drive/MyDrive/CSE445_Videos\"\n",
        "INPUT_VIDEO = os.path.join(DRIVE_DIR, \"video_05.mp4\")\n",
        "OUTPUT_VIDEO = os.path.join(DRIVE_DIR, \"tracked_video_05.mp4\")\n",
        "OUTPUT_CSV = os.path.join(DRIVE_DIR, \"video_05_analytics.csv\")\n",
        "\n",
        "# Verify input file exists\n",
        "if not os.path.exists(INPUT_VIDEO):\n",
        "    raise FileNotFoundError(f\"Input video not found at: {INPUT_VIDEO}\")\n",
        "\n",
        "# Load YOLOv8 Model\n",
        "model = YOLO(\"yolov8n.pt\")  # or your custom trained model path\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 3. Video Processing & Object Tracking\n",
        "# ---------------------------------------------------------\n",
        "cap = cv2.VideoCapture(INPUT_VIDEO)\n",
        "width = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\n",
        "fps = int(cap.get(cv2.CAP_PROP_FPS))\n",
        "frame_w = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))\n",
        "frame_h = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))\n",
        "\n",
        "# Video Writer\n",
        "fourcc = cv2.VideoWriter_fourcc(*\"mp4v\")\n",
        "out = cv2.VideoWriter(OUTPUT_VIDEO, fourcc, fps, (frame_w, frame_h))\n",
        "\n",
        "analytics_data = []\n",
        "unique_ids = set()\n",
        "frame_idx = 0\n",
        "\n",
        "print(f\"🚀 Starting tracking process for: video_05.mp4 ...\")\n",
        "\n",
        "while cap.isOpened():\n",
        "    ret, frame = cap.read()\n",
        "    if not ret:\n",
        "        break\n",
        "\n",
        "    frame_idx += 1\n",
        "\n",
        "    # Run YOLOv8 + ByteTrack\n",
        "    results = model.track(frame, persist=True, tracker=\"bytetrack.yaml\", verbose=False)\n",
        "\n",
        "    annotated_frame = frame.copy()\n",
        "\n",
        "    if results[0].boxes is not None and results[0].boxes.id is not None:\n",
        "        boxes = results[0].boxes.xyxy.cpu().numpy()\n",
        "        track_ids = results[0].boxes.id.int().cpu().numpy()\n",
        "        cls_ids = results[0].boxes.cls.int().cpu().numpy()\n",
        "        confs = results[0].boxes.conf.cpu().numpy()\n",
        "\n",
        "        annotated_frame = results[0].plot()\n",
        "\n",
        "        for box, track_id, cls_id, conf in zip(boxes, track_ids, cls_ids, confs):\n",
        "            class_name = model.names[cls_id]\n",
        "            unique_ids.add(track_id)\n",
        "\n",
        "            # Store analytics entry\n",
        "            analytics_data.append({\n",
        "                \"frame_number\": frame_idx,\n",
        "                \"object_id\": track_id,\n",
        "                \"class_name\": class_name,\n",
        "                \"confidence\": round(float(conf), 4),\n",
        "                \"bbox_x1\": round(float(box[0]), 2),\n",
        "                \"bbox_y1\": round(float(box[1]), 2),\n",
        "                \"bbox_x2\": round(float(box[2]), 2),\n",
        "                \"bbox_y2\": round(float(box[3]), 2)\n",
        "            })\n",
        "\n",
        "    out.write(annotated_frame)\n",
        "\n",
        "cap.release()\n",
        "out.release()\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 4. Save Analytics CSV\n",
        "# ---------------------------------------------------------\n",
        "df_analytics = pd.DataFrame(analytics_data)\n",
        "df_analytics.to_csv(OUTPUT_CSV, index=False)\n",
        "\n",
        "print(\"\\n---------------------------------------------------------\")\n",
        "print(f\"✅ Processing Complete for video_05.mp4!\")\n",
        "print(f\"📹 Rendered Video Saved: {OUTPUT_VIDEO}\")\n",
        "print(f\"📊 CSV Analytics Saved: {OUTPUT_CSV}\")\n",
        "print(f\"🏷️ Unique Objects Tracked: {len(unique_ids)}\")\n",
        "print(\"---------------------------------------------------------\")"
