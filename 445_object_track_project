        "import os\n",
        "import gc\n",
        "import torch\n",
        "import pandas as pd\n",
        "from ultralytics import YOLO\n",
        "from google.colab import drive\n",
        "\n",
        "# 1. Mount Drive if not already mounted\n",
        "drive.mount('/content/drive')\n",
        "\n",
        "# 2. Paths Setup\n",
        "video_folder = '/content/drive/MyDrive/CSE445_Videos/'\n",
        "output_csv_folder = '/content/analytics_outputs/'\n",
        "os.makedirs(output_csv_folder, exist_ok=True)\n",
        "\n",
        "# 3. Load Model\n",
        "model = YOLO('yolov8n.pt')\n",
        "\n",
        "# 4. Find Videos\n",
        "video_files = [f for f in os.listdir(video_folder) if f.endswith(('.mp4', '.avi', '.mov', '.mkv'))]\n",
        "print(f\"🎥 Found {len(video_files)} video(s) in Drive: {video_files}\")\n",
        "\n",
        "# -------------------------------------------------------------\n",
        "# 5. MEMORY-EFFICIENT STREAMING LOOP\n",
        "# -------------------------------------------------------------\n",
        "for idx, video_name in enumerate(video_files, 1):\n",
        "    video_path = os.path.join(video_folder, video_name)\n",
        "    print(f\"\\n==========================================\")\n",
        "    print(f\"⚡ Processing Video {idx}/{len(video_files)}: {video_name}\")\n",
        "    print(f\"==========================================\")\n",
        "\n",
        "    tracking_data = []\n",
        "\n",
        "    # CRITICAL FIX: stream=True processes frame-by-frame to prevent RAM crash\n",
        "    results_generator = model.track(\n",
        "        source=video_path,\n",
        "        save=False,               # Do not save video to disk/RAM\n",
        "        persist=True,             # Maintain object IDs across frames\n",
        "        tracker=\"bytetrack.yaml\", # Tracking algorithm\n",
        "        conf=0.25,\n",
        "        iou=0.5,\n",
        "        stream=True               # <--- PREVENTS OOM / KERNEL CRASH\n",
        "    )\n",
        "\n",
        "    # Process generator frame-by-frame\n",
        "    for frame_idx, r in enumerate(results_generator):\n",
        "        if r.boxes is not None and r.boxes.id is not None:\n",
        "            # Extract box coordinates [x_center, y_center, width, height]\n",
        "            boxes = r.boxes.xywh.cpu().numpy()\n",
        "            ids = r.boxes.id.int().tolist()\n",
        "            cls_ids = r.boxes.cls.int().tolist()\n",
        "\n",
        "            for box, obj_id, cls_id in zip(boxes, ids, cls_ids):\n",
        "                class_name = model.names[cls_id]\n",
        "                x_center, y_center, width, height = box\n",
        "\n",
        "                tracking_data.append({\n",
        "                    \"Frame\": frame_idx,\n",
        "                    \"Tracking_ID\": obj_id,\n",
        "                    \"Class\": class_name,\n",
        "                    \"X_Center\": round(float(x_center), 2),\n",
        "                    \"Y_Center\": round(float(y_center), 2),\n",
        "                    \"Width\": round(float(width), 2),\n",
        "                    \"Height\": round(float(height), 2)\n",
        "                })\n",
        "\n",
        "    # Save CSV for this video\n",
        "    df_tracking = pd.DataFrame(tracking_data)\n",
        "    csv_filename = f\"{os.path.splitext(video_name)[0]}_analytics.csv\"\n",
        "    csv_path = os.path.join(output_csv_folder, csv_filename)\n",
        "\n",
        "    df_tracking.to_csv(csv_path, index=False)\n",
        "\n",
        "    unique_units = df_tracking[\"Tracking_ID\"].nunique() if not df_tracking.empty else 0\n",
        "    print(f\"✅ Saved CSV: {csv_filename} | Total Tracked Objects: {unique_units}\")\n",
        "\n",
        "    # Force GPU/CPU Memory Cleanup after each video\n",
        "    del tracking_data, df_tracking\n",
        "    gc.collect()\n",
        "    if torch.cuda.is_available():\n",
        "        torch.cuda.empty_cache()\n",
        "\n",
        "print(\"\\n🎉 ALL VIDEOS PROCESSED WITHOUT RAM CRASHES!\")"
