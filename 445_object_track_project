        "import os\n",
        "import gc\n",
        "import cv2\n",
        "import torch\n",
        "import pandas as pd\n",
        "from ultralytics import YOLO\n",
        "from google.colab import drive\n",
        "\n",
        "\n",
        "drive.mount('/content/drive')\n",
        "\n",
        "# 2.Setup Paths\n",
        "video_folder = '/content/drive/MyDrive/CSE445_Videos/'\n",
        "output_csv_folder = '/content/analytics_outputs/'\n",
        "output_video_folder = '/content/drive/MyDrive/CSE445_Tracked_Videos/' # Saves rendered MP4s straight to Drive!\n",
        "\n",
        "os.makedirs(output_csv_folder, exist_ok=True)\n",
        "os.makedirs(output_video_folder, exist_ok=True)\n",
        "\n",
        "#Load Model\n",
        "model = YOLO('yolov8n.pt')\n",
        "\n",
        "# Get video files\n",
        "video_files = [f for f in os.listdir(video_folder) if f.endswith(('.mp4', '.avi', '.mov', '.mkv'))]\n",
        "print(f\"🎥 Found {len(video_files)} video(s) to track & render: {video_files}\")\n",
        "\n",
        "\n",
        "for idx, video_name in enumerate(video_files, 1):\n",
        "    video_path = os.path.join(video_folder, video_name)\n",
        "    output_video_path = os.path.join(output_video_folder, f\"tracked_{video_name}\")\n",
        "\n",
        "    print(f\"\\n==========================================\")\n",
        "    print(f\"⚡ Track & Render Video {idx}/{len(video_files)}: {video_name}\")\n",
        "    print(f\"==========================================\")\n",
        "\n",
        "    # Open input video to extract original dimensions and FPS\n",
        "    cap = cv2.VideoCapture(video_path)\n",
        "    width  = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))\n",
        "    height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))\n",
        "    fps    = cap.get(cv2.CAP_PROP_FPS)\n",
        "    if fps == 0 or fps is None: fps = 30.0\n",
        "    cap.release()\n",
        "\n",
        "    # Initialize OpenCV VideoWriter for rendered video output\n",
        "    fourcc = cv2.VideoWriter_fourcc(*'mp4v')\n",
        "    out_video = cv2.VideoWriter(output_video_path, fourcc, fps, (width, height))\n",
        "\n",
        "    tracking_data = []\n",
        "\n",
        "    # Run YOLO with stream=True for memory efficiency\n",
        "    results_generator = model.track(\n",
        "        source=video_path,\n",
        "        save=False,\n",
        "        persist=True,\n",
