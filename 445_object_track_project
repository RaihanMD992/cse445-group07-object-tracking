        "\n",
        "        # Save image FIRST (guarantees images exist)\n",
        "        cv2.imwrite(img_path, frame)\n",
        "\n",
        "        # Detect person (0) and sports ball (32) with low threshold for small drone objects\n",
        "        results = teacher_model.predict(frame, imgsz=1024, conf=0.15, classes=[0, 32], verbose=False)\n",
        "\n",
        "        # Save normalized YOLO format annotations\n",
        "        h, w, _ = frame.shape\n",
